# BoookBox PWA Environment Variables

# API Configuration
VITE_API_BASE_URL=https://boookbox-backend-cpvu.onrender.com

VITE_USER_APP_URL=https://boookbox-user.com #CHANGE TO THE USER BOOOKBOX DOMAIN
VITE_BUSINESS_APP_URL=https://boookbox-business.com #CHANGE TO THE BUSINESS BOOOKBOX DOMAIN

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# App Configuration
VITE_APP_NAME=BoookBox
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# PWA Configuration
VITE_PWA_ENABLED=true

# Google OAuth Configuration
VITE_GOOGLE_CLIENT_ID=your_google_client_id

# ============================
# PAYMENT CALCULATION SETTINGS
# ============================
# These values MUST match your backend exactly!

# Service Fee (percentage of meal + delivery)
VITE_BOOKING_SERVICE_FEE_PERCENT=0

# VAT (percentage for tax calculation)
VITE_BOOKING_VAT_PERCENT=1.5

# BoookBox Platform Charge (percentage of meal amount)
VITE_BOOKING_BOOOKBOX_CHARGE_PERCENT=10

# Paystack Charge (percentage of meal amount)  
VITE_BOOKING_PAYSTACK_CHARGE_PERCENT=5

# Gateway (Paystack) Settings (legacy - for complex calculations)
VITE_BOOKING_GATEWAY_PERCENT=1.5
VITE_BOOKING_GATEWAY_FLAT_FEE=100
VITE_BOOKING_GATEWAY_OFFSET=0

# Platform (BoookBox) Settings (legacy)
VITE_BOOKING_PLATFORM_PERCENT=1
VITE_BOOKING_PLATFORM_FLAT_FEE=100

# Default Tax Amount
VITE_BOOKING_TAX=0

# Debugging
VITE_DEBUG=false